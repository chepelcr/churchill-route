        {"shape": "stripes", "n": 4, "palette": ["#f08a5d", "#fff"], "x": -16, "y": -14, "w": 32, "h": 6},
        {"shape": "rect", "fill": "rgba(255,255,255,0.9)", "x": -4, "y": -4, "w": 8, "h": 12},
        {"shape": "rect", "fill": "#ff3d80", "x": -4, "y": 0, "w": 8, "h": 6},
        {"shape": "rect", "fill": "#fff", "x": -4, "y": -4, "w": 8, "h": 3},
        {"shape": "label", "x": 0, "y": -22, "text": "CHURCHILL", "fg": "#fff", "bg": "#f08a5d"}
      ]
    },

    "ferry": {
