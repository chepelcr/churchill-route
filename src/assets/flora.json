  "defaults": {
    "treeSpecies": "almendro",
    "palmSpecies": "palma",
    "mangroveMix": "channel_edge",
    "_note": "Wire-format defaults: generated tree/palm records omit `k` for these identities; unlabelled mangrove points resolve through this zone. Unknown explicit ids still throw."
  },
  "vocabulary": {
    "kinds": ["taxon", "condition", "placeholder"],
    "origins": ["native", "introduced", "unresolved", "not_applicable"],
    "occurrences": ["observed_local", "regional_reference", "authored_legacy"],
    "habitats": {
      "urban_center": "Documented or deliberately planted in the central urban peninsula.",
      "coastal_urban": "Beach edge, paseo, median or other salt- and wind-exposed urban planting.",
      "dry_forest": "Seasonal Pacific dry forest; native mixes must not contain introduced ornamentals.",
      "transition_forest": "The Miramar and foothill transition behind the port, not a generic conifer highland.",
      "mangrove_channel_edge": "Intertidal waterline and channel edge currently emitted by the world builder.",
      "mangrove_interior": "Landward or higher-salinity interior mangrove; catalogued now, pending interior polygons.",
      "cultivated_upland": "Cultivated legacy asset retained for manual placement, never a native Puntarenas mix."
    },
    "rootArchitectures": ["prop", "spike", "buttress", "collar"]
  },
