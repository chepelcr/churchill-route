   "_note": "la playa ENTRE lengua y lengua, a todo lo largo de la explanada: una franja regular de arena pegada a su borde, más corta que las lenguas para que éstas sigan saliendo al mar."
  }
 },
 "paseo": {
  "_note": "EL FRENTE DEL PASEO, desde donde termina la explanada del Faro hasta el Muelle de Cruceros, en TRES franjas regulares paralelas a la calle: el malecón de siempre contra la acera (su baldosa color arena, `malecon.band`), después el verde, y la playa al frente. Reemplaza la franja de contorno irregular que dejó el ráster.",
  "greenM": 17.0,
  "beachM": 24.0,
  "green": "park",
  "_widths": "ancho de cada franja, de la acera hacia el mar: malecón, verde, playa. La playa mide lo mismo que la que va entre lengua y lengua de la explanada (`malecon.cove.beachM`): es UNA playa, del mismo fondo de punta a punta.",
  "maleconM": 14.0,
  "along": [
   "Paseo de Los Turistas",
   "Paseo León Cortés Castro"
  ],
  "_along": "la guía de este tramo no se traza: es la línea de centro de estas calles, tal como el mundo las emite, de oeste a este.",
  "until": {
   "pier": "muelle_nacional",
   "pastM": 4.0,
   "_note": "el Muelle de Cruceros: el malecón de baldosa y su playa llegan hasta él; la playa pasa por debajo y sigue en el tramo del parque (`cruceros.park`)."
  },
  "joinM": 70.0,
  "_joinM": "LA UNIÓN CON LA EXPLANADA no es un corte: a lo largo de estos metros la piedra gris se angosta en un triángulo de lados curvos que muere contra el borde del malecón, mientras el malecón de baldosa, el verde y la playa nacen y crecen a su lado. Las dos secciones quedan cosidas.",
  "endM": 45.0,
  "_endM": "y el otro extremo tampoco: frente al Muelle de Cruceros el verde y la playa se cierran con la misma curva en vez de terminar a escuadra.",
  "riprap": true,
  "_riprap": "la línea de piedra sigue: viene por el borde de la explanada, baja por la unión y continúa ENTRE el malecón y el verde hasta el final.",
  "straightFrom": "Paseo León Cortés Castro",
  "_straightFrom": "donde empieza esta calle el Paseo se abre tierra adentro hacia el Muelle de Cruceros y deja una plazoleta con los kioscos. Las franjas NO doblan con ella: siguen derechas, con el rumbo que traían, y la cuña que queda entre la calle y ellas es malecón de baldosa — la plazoleta de los kioscos. Doblar con la calle era lo que plegaba el verde y la playa sobre sí mismos.",
  "greenUntil": "straightFrom",
  "_greenUntil": "el verde se cierra ANTES de donde empieza el Paseo León Cortés: en el tramo de los kioscos y de ahí en adelante hay sólo malecón y playa."
 },
 "cruceros": {
  "_note": "LA ENTRADA DEL MUELLE DE CRUCEROS. El muelle se corre al norte hasta pegar con el final de su calle: calle y muelle son una sola línea, y la playa pasa por debajo. En la boca va un arco como el de la feria, con el nombre en letras blancas sobre azul. La caseta va a la IZQUIERDA del muelle y sobre el malecón, no en la arena, y sin rótulo: el nombre ya lo dice el arco.",
  "pier": "muelle_nacional",
  "street": "Calle Central",
  "landmark": "muellecruc",
  "casetaSide": "west",
  "casetaOffM": [
   17.0
  ],
  "gate": {
   "text": "MUELLE DE CRUCEROS",
   "widthM": 31.0
  },
  "capitania": {
   "landmark": "capitania",
   "replacesBuilding": "MOPT - Capitanía de Puerto Puntarenas",
   "dropParcel": "lote_capitania",
   "_note": "la Capitanía de Puerto estaba dibujada en la cuadra equivocada, sobre una parcela con fondo y borde blanco; va donde OSM tiene el edificio del MOPT, y ese edificio genérico sale.",
   "southM": 9.0
  },
  "kiosks": {
   "ids": [
    "kios_paseo1",
    "kios_paseo2"
   ],
   "hiddenLanes": true,
   "fromRocksM": 11.0,
   "_note": "los dos kioscos suben de la arena al malecón de baldosa, del lado de la calle de la línea de piedra, y sus calles auxiliares siguen manejables pero no se pintan."
  },
  "dropPiers": [
   "bajada_muelle_oeste",
   "bajada_muelle_este"
  ],
  "_dropPiers": "las dos bajadas a la arena salían de la plazoleta vieja del muelle; con el muelle pegado a la calle y la playa pasando por debajo quedan sueltas sobre la arena.",
  "casetaFromRocksM": 9.0,
  "park": {
   "_note": "AL ESTE DEL MUELLE el malecón de baldosa se acaba: el Parque del Muellero —que ya existe, a lo largo del Paseo León Cortés— es su remate, con una cuña de baldosa que muere contra él. Al frente del parque va sólo playa, una franja regular del mismo fondo, y la línea de piedra entre parque y playa. Reemplaza la plazoleta de contorno irregular que había ahí.",
   "parcel": "osm_park_270515697",
   "along": "Paseo León Cortés Castro",
   "blendM": 80.0
  }
 },
 "muelle": {
  "_note": "EL MUELLE DEL FARO SE QUEDA, con su kiosco: nace en el borde del malecón nuevo. Su calle auxiliar también se queda, y sigue siendo manejable, pero NO SE PINTA — por encima se ve piso de malecón, y quien la encuentre llega en carro hasta el kiosco. Un huevo de pascua.",
  "pier": "muelle_faro",
  "kiosk": "kios_faro",
  "hiddenLane": true
 },
