    "boat": "#8a5a35",
    "boatTrim": "#f3c969",
    "track": "#6a7280",
    "facade": "#3a2a4a",
    "facadeTrim": "#6b2f8f",
    "facadeDoor": "#0d0a12",
    "counter": "#b8875a",
    "counterTop": "#f6e7c8",
    "tarpEave": "#0e2258",
    "tarpRidge": "#2f6fc0",
    "tarpFill": "#17357f",
    "frame": "#e8ecef",
